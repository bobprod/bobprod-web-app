PORT=3001
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string
# 32 bytes, hex-encoded — distinct from JWT_SECRET. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LLM_ENCRYPTION_KEY=replace-with-a-64-char-hex-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# WhatsApp number for the "Réserver" buttons, international format, digits only (e.g. 216XXXXXXXX). Leave empty to hide them.
PUBLIC_WHATSAPP_NUMBER=
